# Umami analytics (optional)
# Copy this file to `.env` and fill in your values to enable analytics.
# If left unset, no analytics script is injected and the build stays clean.
#
# VITE_ANALYTICS_SRC=https://your-umami-instance.com/script.js
# VITE_ANALYTICS_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
